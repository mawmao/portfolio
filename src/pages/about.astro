---
import Layout from "@/layouts/Layout.astro";
import TechTag from "@/components/ui/TechTag.astro";
import { Image } from "astro:assets";
import Me from "@/assets/images/me-1.jpg";
import ArrowUp from "@/assets/icons/arrow-up.svg";

const experience = [
  {
    role: "Full-Stack Engineer",
    company: "Independent / Client & Product Engineering",
    period: "2026 - Present",
    current: true,
    relatedWork: { label: "View Verori case study", href: "/works/verori" },
    description:
      "Designing and shipping multi-tenant SaaS platforms, custom internal tools and data systems using Next.js, React and Supabase with end-to-end ownership from schema design to deployment.",
  },
  {
    role: "Full-Stack Engineer",
    company: "Department of Agriculture VI",
    period: "Mar 2025 - May 2026",
    current: false,
    relatedWork: { label: "View Humay case study", href: "/works/humay" },
    description:
      "Architected and shipped an offline-capable Kotlin Android app and React analytics dashboard. Engineered PostgreSQL Row-Level Security (RLS) across 3 user roles and achieved an ISO 25010 Excellent rating.",
  },
  {
    role: "Web Developer Intern",
    company: "Iloilo Provincial Tourism Office (PCAHTO)",
    period: "Jan 2026 - Apr 2026",
    current: false,
    description:
      "Co-developed an SEO-optimized tourism portal and custom CMS using Astro, React and Supabase so non-technical staff could manage provincial records independently.",
  },
];

const skills = {
  Frontend: ["React", "Next.js", "TypeScript", "JavaScript", "Astro", "Tailwind CSS", "shadcn/ui", "Vue.js"],
  Backend: ["Node.js", "Supabase", "PostgreSQL", "MySQL", "REST APIs", "OAuth 2.0", "Go", "Stripe / Polar.sh"],
  Mobile: ["Kotlin", "Jetpack Compose", "React Native / Expo"],
  Tools: ["Git", "GitHub", "Docker", "Linux CLI", "Vercel", "Cloudflare"],
};
---

<Layout
  title="About | Mel Adry | Full-Stack Engineer"
  description="Learn more about Mel Adry, a full-stack engineer based in the Philippines building secure data platforms, internal tools and offline-capable mobile apps."
>
  <main class="w-full min-w-0 flex flex-col flex-1 gap-16 sm:gap-24 py-12 sm:py-20">
    {/* 01 / Overview & Bio */}
    <section aria-labelledby="about-heading" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-10 items-start">
        <div class="col-span-6 sm:col-span-2 flex sm:flex-col justify-between sm:justify-start gap-2 pt-1">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            01 / About
          </span>
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
            Iloilo, PH
          </span>
        </div>

        <div class="col-span-6 sm:col-span-6 flex flex-col gap-6">
          <h1
            id="about-heading"
            class="text-4xl sm:text-5xl lg:text-6xl font-semibold tracking-[-0.03em] leading-[1.06] text-foreground text-balance"
          >
            I build <span class="text-foreground/55">secure systems</span> for web and mobile.
          </h1>

          <div class="flex flex-col gap-5 text-base sm:text-lg leading-relaxed text-foreground/80 max-w-[52ch] text-pretty">
            <p>
              I'm <strong class="font-medium text-foreground">Mel Adry</strong>, a full-stack engineer based in the Philippines. I partner with product and operations teams to build internal tools, multi-tenant platforms and offline-capable mobile apps.
            </p>
            <p>
              Whether a field worker is syncing records offline or a manager is reviewing live metrics, software has to be fast, reliable and secure by default. I focus heavily on database modeling and strict <strong class="font-medium text-foreground">PostgreSQL Row-Level Security (RLS)</strong> so sensitive data stays isolated without slowing down feature delivery.
            </p>
            <p>
              From shipping{" "}
              <a
                href="/works/verori"
                class="font-medium text-foreground underline decoration-foreground/35 underline-offset-4 hover:decoration-foreground transition-colors"
              >
                Verori
              </a>{" "}
              to taking public-sector field systems from schema design to production, I work with high autonomy, dig into library source code when docs fall short and take full ownership of the stack.
            </p>
          </div>
        </div>

        {/* Portrait & Live Metadata Rail */}
        <aside class="col-span-6 sm:col-span-4 flex flex-col border border-foreground/20 bg-background group">
          <div class="relative aspect-4/5 w-full overflow-hidden bg-foreground/5">
            <Image
              src={Me}
              alt="Portrait of Mel Adry, Full-Stack Engineer"
              loading="eager"
              widths={[400, 720]}
              sizes="(min-width: 640px) 34vw, 100vw"
              class="h-full w-full object-cover grayscale transition-all duration-500 ease-out group-hover:grayscale-0 group-hover:scale-[1.02]"
            />
          </div>

          <dl class="flex flex-col divide-y divide-foreground/15 border-t border-foreground/20 text-xs font-mono uppercase tracking-wider text-foreground/60">
            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <dt>Status</dt>
              <dd class="inline-flex items-center gap-2 text-foreground">
                <span class="relative flex h-2 w-2">
                  <span class="motion-safe:animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75"></span>
                  <span class="relative inline-flex h-2 w-2 bg-emerald-500"></span>
                </span>
                <span>Available</span>
              </dd>
            </div>

            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <dt>Location</dt>
              <dd class="text-foreground text-right">Iloilo, Philippines</dd>
            </div>

            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <dt>Local Time</dt>
              <dd id="ph-local-time" class="text-foreground text-right">UTC+8</dd>
            </div>

            <div class="flex items-center justify-between gap-4 px-4 py-3">
              <dt>Focus</dt>
              <dd class="text-foreground text-right">SaaS, Internal Tools &amp; Mobile</dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    {/* 02 / Experience */}
    <section aria-labelledby="experience-heading" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-8 items-start">
        <div class="col-span-6 sm:col-span-2 pt-1">
          <h2 id="experience-heading" class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            02 / Experience
          </h2>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col divide-y divide-foreground/20 border-b border-foreground/20">
          {
            experience.map((job) => (
              <article class="group grid grid-cols-1 sm:grid-cols-10 gap-x-6 gap-y-3 py-8 first:pt-0">
                <div class="sm:col-span-3 flex sm:flex-col justify-between sm:justify-start gap-2 pt-1">
                  <span class="text-xs font-mono uppercase tracking-wider text-foreground/60">
                    {job.period}
                  </span>
                  {job.current && (
                    <span class="inline-flex w-fit items-center border border-foreground/25 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-foreground/75">
                      Current
                    </span>
                  )}
                </div>

                <div class="sm:col-span-7 flex flex-col gap-2.5">
                  <div class="flex flex-col gap-1">
                    <h3 class="text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-foreground">
                      {job.role}
                    </h3>
                    <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
                      {job.company}
                    </span>
                  </div>

                  <p class="text-sm sm:text-base leading-relaxed text-foreground/75 max-w-[54ch] text-pretty pt-1">
                    {job.description}
                  </p>

                  {job.relatedWork && (
                    <a
                      href={job.relatedWork.href}
                      class="mt-2 inline-flex w-fit items-center gap-1.5 border-b border-foreground/35 pb-0.5 text-xs uppercase tracking-wider font-medium text-foreground/80 hover:border-foreground hover:text-foreground transition-colors"
                    >
                      <span>{job.relatedWork.label}</span>
                      <ArrowUp width={12} height={12} aria-hidden="true" class="rotate-45" />
                    </a>
                  )}
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    {/* 03 / Technical Toolbox */}
    <section aria-labelledby="toolbox-heading" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-8 items-start">
        <div class="col-span-6 sm:col-span-2 pt-1">
          <h2 id="toolbox-heading" class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            03 / Toolbox
          </h2>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col gap-8">
          <p class="text-base sm:text-lg leading-relaxed text-foreground/75 max-w-[50ch] text-pretty">
            The core technologies I use daily to architect, build and deploy production software.
          </p>

          <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-l border-foreground/20">
            {
              Object.entries(skills).map(([category, items]) => (
                <div class="flex flex-col gap-4 border-r border-b border-foreground/20 p-6">
                  <h3 class="text-xs font-mono uppercase tracking-wider text-foreground/60">
                    {category}
                  </h3>
                  <div class="flex flex-wrap gap-1.5">
                    {items.map((item) => (
                      <TechTag name={item} />
                    ))}
                  </div>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* 04 / Next Steps */}
    <section aria-label="Next Steps" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-6 items-center">
        <div class="col-span-6 sm:col-span-2">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            04 / Next Step
          </span>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <h2 class="text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-foreground">
              Ready to add a full-stack engineer to your team?
            </h2>
            <p class="text-sm sm:text-base text-foreground/70">
              Review production case studies or reach out directly to discuss open roles.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 shrink-0">
            <a
              href="/works"
              class="group inline-flex h-11 items-center justify-center gap-2 border border-foreground/30 px-6 text-xs uppercase tracking-wider font-medium text-foreground transition-colors duration-150 hover:border-foreground hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
            >
              <span>Selected works</span>
              <ArrowUp
                width={14}
                height={14}
                aria-hidden="true"
                class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>

            <a
              href="/contact"
              class="group inline-flex h-11 items-center justify-center gap-2 bg-foreground px-7 text-xs uppercase tracking-wider font-medium text-background transition-colors duration-150 hover:bg-foreground/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
            >
              <span>Get in touch</span>
              <ArrowUp
                width={14}
                height={14}
                aria-hidden="true"
                class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
              />
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<script>
  function updateLocalTime() {
    const el = document.getElementById("ph-local-time");
    if (!el) return;

    const formatter = new Intl.DateTimeFormat("en-US", {
      timeZone: "Asia/Manila",
      hour: "2-digit",
      minute: "2-digit",
      hour12: true,
    });

    el.textContent = `${formatter.format(new Date())} (PHT)`;
  }

  updateLocalTime();
  document.addEventListener("astro:page-load", updateLocalTime);
</script>
