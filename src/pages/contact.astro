---
import Layout from "@/layouts/Layout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import Separator from "@/components/ui/Separator.astro";

const email = "meladry.co@gmail.com";
const github = "https://github.com/mawmao";
const linkedIn = "https://linkedin.com/in/meladryco";

const formSpreeId = "NOT YET IMPLEMENTED"
---

<Layout>
  <main class="w-full min-w-0 flex flex-col flex-1">
    <section class="py-16 sm:py-24 md:py-32 flex flex-col gap-6 max-w-4xl">
      <div class="flex items-center gap-3">
        <span class="relative flex h-2.5 w-2.5">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"
          ></span>
          <span
            class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"
          ></span>
        </span>
        <span
          class="text-xs font-mono uppercase tracking-widest text-foreground/60"
        >
          Available for new projects
        </span>
      </div>

      <h1
        class="font-bold text-5xl sm:text-6xl md:text-7xl lg:text-8xl -tracking-tight-2 leading-none"
      >
        Let's talk.
      </h1>

      <p
        class="text-lg sm:text-xl md:text-2xl text-foreground/70 max-w-[45ch] leading-snug"
      >
        Have a project in mind, want to collaborate, or just want to say hi?
        Drop a message below or reach out directly.
      </p>
    </section>

    <Separator />

    <section
      class="py-16 sm:py-24 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-24"
    >
      <div class="md:col-span-5 flex flex-col gap-12">
        <div class="flex flex-col gap-6">
          <h3
            class="text-xs font-mono uppercase tracking-widest text-foreground/50 border-b border-dashed border-foreground/20 pb-2"
          >
            Direct Contact
          </h3>

          <div class="flex flex-col gap-2">
            <span class="text-sm text-foreground/60">Email</span>
            <a
              href={"mailto:" + email}
              class="text-xl sm:text-2xl font-medium hover:underline decoration-foreground/30 underline-offset-4"
            >
              {email}
            </a>
          </div>

          <div class="flex flex-col gap-2 mt-4">
            <span class="text-sm text-foreground/60">Location</span>
            <span class="text-xl sm:text-2xl font-medium"
              >Iloilo, Philippines</span
            >
          </div>
        </div>

        <div class="flex flex-col gap-4">
          <h3
            class="text-xs font-mono uppercase tracking-widest text-foreground/50 border-b border-dashed border-foreground/20 pb-2"
          >
            Socials
          </h3>
          <div class="flex flex-col gap-2 font-medium">
            <a
              href={github}
              target="_blank"
              rel="noopener"
              class="hover:text-foreground/60 transition-colors">GitHub ↗</a
            >
            <a
              href={linkedIn}
              target="_blank"
              rel="noopener"
              class="hover:text-foreground/60 transition-colors">LinkedIn ↗</a
            >
          </div>
        </div>
      </div>

      <div class="md:col-span-7">
        <form
          action={formSpreeId}
          method="POST"
          class="flex flex-col gap-6"
        >
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <div class="flex flex-col gap-2">
              <label
                for="name"
                class="text-xs font-mono uppercase tracking-widest text-foreground/60"
                >Name</label
              >
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full bg-transparent border border-foreground/20 px-4 py-3 text-sm focus:outline-none focus:border-foreground transition-colors placeholder:text-foreground/30"
                placeholder="John Doe"
              />
            </div>

            <div class="flex flex-col gap-2">
              <label
                for="email"
                class="text-xs font-mono uppercase tracking-widest text-foreground/60"
                >Email</label
              >
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full bg-transparent border border-foreground/20 px-4 py-3 text-sm focus:outline-none focus:border-foreground transition-colors placeholder:text-foreground/30"
                placeholder="john@example.com"
              />
            </div>
          </div>

          <div class="flex flex-col gap-2">
            <label
              for="message"
              class="text-xs font-mono uppercase tracking-widest text-foreground/60"
              >Message</label
            >
            <textarea
              id="message"
              name="message"
              required
              rows="6"
              class="w-full bg-transparent border border-foreground/20 px-4 py-3 text-sm focus:outline-none focus:border-foreground transition-colors resize-none placeholder:text-foreground/30"
              placeholder="Tell me about your project..."></textarea>
          </div>

          <button
            type="submit"
            class="group inline-flex h-12 w-full sm:w-fit cursor-pointer items-center justify-center gap-2 bg-foreground px-8 text-sm font-medium uppercase text-background transition-colors duration-200 hover:bg-foreground/80 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground mt-2"
          >
            <span>Send Message</span>
            <ArrowUp
              width={16}
              height={16}
              class="rotate-90 transition-transform duration-200 group-hover:translate-x-1"
            />
          </button>
        </form>
      </div>
    </section>
  </main>
</Layout>
