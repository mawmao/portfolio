---
import Layout from "@/layouts/Layout.astro";
import TechTag from "@/components/ui/TechTag.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import { Image } from "astro:assets";
import { works } from "@/data/works";
---

<Layout
  title="Selected Works & Case Studies | Mel Adry | Full-Stack Engineer"
  description="Explore internal tools, business dashboards, and secure data platforms engineered by Mel Adry using Astro, React, TypeScript, and PostgreSQL."
>
  <main class="w-full min-w-0 flex flex-col flex-1 gap-16 sm:gap-24 py-12 sm:py-20">
    <section aria-labelledby="works-heading" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-6 items-start">
        <div class="col-span-6 sm:col-span-2 flex sm:flex-col justify-between sm:justify-start gap-2 pt-1">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60"> 01 / Archive </span>
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
            {String(works.length).padStart(2, "0")}
            {works.length === 1 ? "Case Study" : "Case Studies"}
          </span>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col gap-5">
          <h1
            id="works-heading"
            class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.035em] leading-[1.02] text-foreground"
          >
            Selected works
          </h1>

          <p class="text-base sm:text-xl leading-relaxed text-foreground/75 max-w-[54ch] text-pretty">
            Production systems, internal dashboards, and secure data platforms built from database schema to deployment.
            Each case study breaks down architecture, security constraints, and delivery outcomes.
          </p>
        </div>
      </div>
    </section>

    <section aria-label="Case Studies List" class="flex flex-col gap-4">
      <div
        class="hidden md:grid md:grid-cols-12 gap-x-6 pb-3 border-b border-foreground text-[11px] font-mono uppercase tracking-wider text-foreground/55"
      >
        <div class="col-span-2">Index / Year</div>
        <div class="col-span-4">Project &amp; Scope</div>
        <div class="col-span-3">Stack</div>
        <div class="col-span-3 text-right">Preview / Action</div>
      </div>

      <div class="flex flex-col divide-y divide-foreground/20 border-b border-foreground/20">
        {
          works.map((work, index) => (
            <a
              href={`/works/${work.slug}`}
              aria-label={`Read case study about ${work.title}`}
              class="group grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-x-6 items-start md:items-center py-8 sm:py-10 transition-colors duration-150 hover:bg-foreground/[0.02] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
            >
              <div class="md:col-span-2 flex md:flex-col items-center md:items-start justify-between gap-1.5 text-xs sm:text-sm font-mono text-foreground/55 group-hover:text-foreground transition-colors">
                <span>[{String(index + 1).padStart(2, "0")}]</span>
                <span class="text-foreground/75">{work.year}</span>
              </div>

              <div class="md:col-span-4 flex flex-col gap-2.5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
                    {work.organization}
                  </span>
                  {work.isPrivate && (
                    <span class="inline-flex items-center gap-1 border border-foreground/25 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-foreground/65">
                      <svg
                        width="10"
                        height="10"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="3" y="11" width="18" height="11" rx="0" ry="0" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                      <span>Private</span>
                    </span>
                  )}
                </div>

                <h2 class="text-2xl sm:text-3xl font-semibold tracking-tight leading-[1.1] text-foreground">
                  <span class="underline decoration-transparent underline-offset-4 group-hover:decoration-foreground transition-colors duration-150">
                    {work.title}
                  </span>
                </h2>

                <p class="text-sm leading-relaxed text-foreground/75 line-clamp-2 max-w-[44ch] text-pretty">
                  {work.description}
                </p>
              </div>

              <div class="md:col-span-3 flex flex-wrap gap-1.5">
                {work.tags.slice(0, 4).map((tag) => (
                  <TechTag name={tag} />
                ))}
                {work.tags.length > 4 && (
                  <span class="inline-flex items-center border border-foreground/15 px-2 py-1 text-xs font-mono text-foreground/55">
                    +{work.tags.length - 4}
                  </span>
                )}
              </div>

              <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-4 w-full">
                <div class="relative w-full max-w-[220px] md:w-36 aspect-video overflow-hidden border border-foreground/20 bg-foreground/5">
                  <Image
                    src={work.images[0]}
                    alt={`${work.title} interface preview`}
                    widths={[320, 480]}
                    sizes="(min-width: 768px) 150px, 220px"
                    class="w-full h-full object-cover grayscale transition-all duration-300 ease-out group-hover:grayscale-0 group-hover:scale-[1.03]"
                  />
                </div>

                <span
                  aria-hidden="true"
                  class="h-10 w-10 shrink-0 flex items-center justify-center border border-foreground/30 text-foreground transition-colors duration-150 group-hover:bg-foreground group-hover:text-background group-hover:border-foreground"
                >
                  <ArrowUp
                    width={15}
                    height={15}
                    class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                  />
                </span>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section aria-labelledby="works-cta-heading" class="flex flex-col gap-6 pt-4">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-6 items-center">
        <div class="col-span-6 sm:col-span-2">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60"> 02 / Next Step </span>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="flex flex-col gap-1.5">
            <h2 id="works-cta-heading" class="text-xl sm:text-2xl font-semibold tracking-[-0.02em] text-foreground">
              Need an engineer to ship reliable product systems?
            </h2>
            <p class="text-sm sm:text-base text-foreground/70">
              Available for full-time engineering roles, contract engagements and production hardening.
            </p>
          </div>

          <a
            href="/contact"
            class="group inline-flex h-11 w-full sm:w-fit shrink-0 items-center justify-center gap-2.5 bg-foreground px-7 text-xs uppercase tracking-wider font-medium text-background transition-colors duration-150 hover:bg-foreground/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
          >
            <span>Get in touch</span>
            <ArrowUp
              width={14}
              height={14}
              class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
