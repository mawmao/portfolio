---
import Layout from "@/layouts/Layout.astro";
import Separator from "@/components/ui/Separator.astro";
import TechTag from "@/components/ui/TechTag.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import { Image } from "astro:assets";
import { works } from "@/data/works";
---

<Layout
  title="Selected Works & Case Studies | Mel Adry | Full-Stack Engineer"
  description="Explore a collection of internal tools, business dashboards, and secure data platforms engineered by Mel Adry using Astro, React, and Supabase."
>
  <main class="w-full min-w-0 flex flex-col flex-1 py-12 sm:py-20 lg:py-28">
    <section aria-labelledby="works-heading" class="flex flex-col gap-6 pb-12 sm:pb-16">
      <div class="flex items-center justify-between gap-4">
        <div class="text-sm sm:text-base text-foreground font-bold w-fit flex items-center gap-1.5">
          <span class="font-mono text-foreground/45 select-none">//</span>
          <span class="font-mono font-normal uppercase tracking-widest text-foreground/75">Archive & Index</span>
          <span class="font-mono animate-pulse select-none">_</span>
        </div>

        <span class="text-xs font-mono uppercase tracking-widest text-foreground/50">
          {String(works.length).padStart(2, "0")}
          {works.length === 1 ? "Project" : "Projects"}
        </span>
      </div>

      <h1
        id="works-heading"
        class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-bold uppercase -tracking-tight-2 leading-[0.95] text-balance"
      >
        Selected Works.
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl text-foreground/70 max-w-2xl leading-snug">
        A collection of SaaS products, internal tools, and secure data platforms engineered from database schema to
        production.
      </p>
    </section>

    <Separator />

    <section aria-label="Case Studies List" class="pt-8 sm:pt-14 pb-16">
      <div
        class="hidden md:grid md:grid-cols-12 gap-8 pb-4 text-[11px] font-mono uppercase tracking-widest text-foreground/45"
      >
        <div class="col-span-2">Index / Year</div>
        <div class="col-span-4">Project</div>
        <div class="col-span-3">Stack</div>
        <div class="col-span-3 text-right">Preview</div>
      </div>

      <div class="flex flex-col border-t border-dashed border-foreground/20">
        {
          works.map((work, index) => (
            <a
              href={`/works/${work.slug}`}
              class="group relative grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-8 items-start md:items-center py-8 sm:py-10 md:py-12 px-2 sm:px-4 -mx-2 sm:-mx-4 border-b border-dashed border-foreground/20 hover:bg-foreground/[0.025] transition-colors"
            >
              <div class="md:col-span-2 flex md:flex-col items-center md:items-start justify-between gap-2 text-xs sm:text-sm font-mono text-foreground/50 group-hover:text-foreground/85 transition-colors">
                <span class="text-foreground/35 group-hover:text-foreground/70 transition-colors">
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span>{work.year}</span>
              </div>

              <div class="md:col-span-4 flex flex-col gap-2.5">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs font-mono uppercase tracking-widest text-foreground/55">
                    {work.organization}
                  </span>
                  {work.isPrivate && (
                    <span class="inline-flex items-center gap-1 rounded-full border border-dashed border-foreground/35 bg-foreground/[0.03] px-2 py-0.5 text-[9px] font-mono uppercase tracking-widest text-foreground/65">
                      <svg
                        width="9"
                        height="9"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                        <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                      </svg>
                      Private
                    </span>
                  )}
                </div>

                <h2 class="text-3xl sm:text-4xl font-bold uppercase -tracking-tight-2 leading-none group-hover:translate-x-1 transition-transform duration-300">
                  {work.title}
                </h2>

                <p class="text-sm text-foreground/65 line-clamp-2 max-w-md leading-relaxed">{work.description}</p>
              </div>

              <div class="md:col-span-3 flex flex-wrap gap-1.5">
                {work.tags.slice(0, 4).map((tag) => (
                  <TechTag name={tag} />
                ))}
                {work.tags.length > 4 && (
                  <span class="inline-flex items-center px-1.5 text-xs font-mono text-foreground/45">
                    +{work.tags.length - 4}
                  </span>
                )}
              </div>

              <div class="md:col-span-3 flex items-center justify-between md:justify-end gap-5 w-full">
                <div class="relative w-full max-w-[220px] sm:max-w-[240px] md:w-36 aspect-video overflow-hidden border border-foreground/20 bg-foreground/5 shadow-sm">
                  <Image
                    src={work.images[0]}
                    alt={`${work.title} preview`}
                    widths={[320, 480]}
                    sizes="(min-width: 768px) 160px, 240px"
                    class="w-full h-full object-cover grayscale-[25%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
                  />
                </div>

                <div class="h-10 w-10 shrink-0 flex items-center justify-center rounded-full border border-foreground/30 text-foreground group-hover:bg-foreground group-hover:text-background group-hover:border-foreground transition-all duration-300">
                  <ArrowUp
                    width={16}
                    height={16}
                    class="rotate-45 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform duration-300"
                  />
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <Separator />

    <section
      aria-label="Contact Call to Action"
      class="pt-14 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6"
    >
      <div class="flex flex-col gap-1">
        <h2 class="text-2xl sm:text-3xl font-bold uppercase -tracking-tight-2">
          Need an engineer for your next build?
        </h2>
        <p class="text-sm sm:text-base text-foreground/60">
          Available for full-stack product engineering, SaaS builds, and internal tools.
        </p>
      </div>
      <a
        href="/contact"
        class="group inline-flex h-12 w-full sm:w-fit shrink-0 items-center justify-center gap-2 bg-foreground px-8 text-xs font-mono uppercase tracking-widest text-background transition-colors hover:bg-foreground/85"
      >
        <span>Get in touch</span>
        <ArrowUp width={14} height={14} class="rotate-90 transition-transform group-hover:translate-x-1" />
      </a>
    </section>
  </main>
</Layout>
