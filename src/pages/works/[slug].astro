---
import Layout from "@/layouts/Layout.astro";
import TechTag from "@/components/ui/TechTag.astro";
import { Image } from "astro:assets";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import { works } from "@/data/works";

export async function getStaticPaths() {
  return works.map((work, index) => {
    const nextWork = works[(index + 1) % works.length];
    return {
      params: { slug: work.slug },
      props: { work, nextWork },
    };
  });
}

const { work, nextWork } = Astro.props;
const [mainImage, ...moreImages] = work.images;
const hasDecisions = Boolean(work.technicalDecisions && work.technicalDecisions.length > 0);
---

<Layout
  title={`${work.title} / Case Study | Mel Adry | Full-Stack Engineer`}
  description={work.description}
  image={mainImage?.src}
>
  <main class="w-full min-w-0 flex flex-col flex-1 gap-16 sm:gap-24 py-12 sm:py-20">
    {/* Breadcrumb & Case Study Header */}
    <section aria-labelledby="case-study-heading" class="flex flex-col gap-6">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      <nav aria-label="Breadcrumb" class="flex items-center justify-between gap-4">
        <a
          href="/works"
          class="group inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-foreground/65 hover:text-foreground transition-colors py-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
        >
          <ArrowUp
            width={13}
            height={13}
            aria-hidden="true"
            class="-rotate-135 transition-transform duration-150 group-hover:-translate-x-0.5"
          />
          <span>Back to all works</span>
        </a>

        <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
          Case Study / {work.year}
        </span>
      </nav>

      <header class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-6 items-start pt-2">
        <div class="col-span-6 sm:col-span-2 flex sm:flex-col justify-between sm:justify-start gap-2 pt-1">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            {work.organization}
          </span>
          {
            work.isPrivate && (
              <span class="inline-flex w-fit items-center gap-1 border border-foreground/25 px-2 py-0.5 text-[10px] font-mono uppercase tracking-wider text-foreground/65">
                <svg
                  width="10"
                  height="10"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect x="3" y="11" width="18" height="11" rx="0" ry="0" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                <span>Private</span>
              </span>
            )
          }
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col gap-6">
          <h1
            id="case-study-heading"
            class="text-4xl sm:text-6xl lg:text-7xl font-semibold tracking-[-0.035em] leading-[1.02] text-foreground"
          >
            {work.title}
          </h1>

          <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
            <p class="text-lg sm:text-xl leading-relaxed text-foreground/75 max-w-[52ch] text-pretty">
              {work.description}
            </p>

            {
              (work.liveUrl || work.repoUrl) && (
                <div class="flex flex-wrap items-center gap-3 shrink-0">
                  {work.liveUrl && (
                    <a
                      href={work.liveUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex h-11 items-center justify-center gap-2 bg-foreground px-6 text-xs uppercase tracking-wider font-medium text-background transition-colors duration-150 hover:bg-foreground/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                    >
                      <span>Live site</span>
                      <ArrowUp
                        width={14}
                        height={14}
                        aria-hidden="true"
                        class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      />
                    </a>
                  )}
                  {work.repoUrl && (
                    <a
                      href={work.repoUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group inline-flex h-11 items-center justify-center gap-2 border border-foreground/30 px-6 text-xs uppercase tracking-wider font-medium text-foreground transition-colors duration-150 hover:border-foreground hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                    >
                      <span>Source code</span>
                      <ArrowUp
                        width={14}
                        height={14}
                        aria-hidden="true"
                        class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                      />
                    </a>
                  )}
                </div>
              )
            }
          </div>
        </div>
      </header>
    </section>

    {/* Primary Showcase Image */}
    {
      mainImage && (
        <figure class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-3">
          <div class="hidden sm:block sm:col-span-2 pt-1">
            <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
              [01] Primary View
            </span>
          </div>

          <div class="col-span-6 sm:col-span-10 flex flex-col gap-2.5">
            <div class="w-full aspect-video border border-foreground/20 bg-foreground/5 overflow-hidden group">
              <Image
                src={mainImage}
                alt={`${work.title} main interface`}
                class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.02]"
                loading="eager"
                widths={[800, 1200, 1600]}
                sizes="(min-width: 1024px) 80vw, 100vw"
              />
            </div>
            <figcaption class="flex items-center justify-between text-xs font-mono uppercase tracking-wider text-foreground/50">
              <span>{work.title}</span>
              <span>{work.isPrivate ? "Internal System Preview" : "Production Interface"}</span>
            </figcaption>
          </div>
        </figure>
      )
    }

    {/* Project Specifications Bar */}
    <section
      aria-label="Project Specifications"
      class="grid grid-cols-2 lg:grid-cols-12 border-t border-b border-foreground/20 py-7 gap-y-6 gap-x-6"
    >
      <div class="lg:col-span-3 flex flex-col gap-1.5">
        <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">Role</span>
        <span class="text-sm sm:text-base font-medium text-foreground">{work.role}</span>
      </div>
      <div class="lg:col-span-2 flex flex-col gap-1.5">
        <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">Timeline</span>
        <span class="text-sm sm:text-base font-medium text-foreground">{work.timeline}</span>
      </div>
      <div class="lg:col-span-2 flex flex-col gap-1.5">
        <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">Year</span>
        <span class="text-sm sm:text-base font-medium text-foreground">{work.year}</span>
      </div>
      <div class="col-span-2 lg:col-span-5 flex flex-col gap-2">
        <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">Stack</span>
        <div class="flex flex-wrap gap-1.5">
          {work.tags.map((tag) => <TechTag name={tag} />)}
        </div>
      </div>
    </section>

    {/* Sticky Index + Case Study Narrative */}
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-x-6">
      <aside class="md:col-span-3">
        <div class="sticky top-24 flex flex-col gap-3">
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
            Index
          </span>
          <nav
            aria-label="Table of contents"
            class="hidden md:flex flex-col gap-2.5 border-l border-foreground/20 pl-4"
          >
            <a
              href="#challenge"
              data-toc-link
              class="text-xs font-mono uppercase tracking-wider text-foreground/60 hover:text-foreground transition-colors"
            >
              01. Challenge
            </a>
            <a
              href="#solution"
              data-toc-link
              class="text-xs font-mono uppercase tracking-wider text-foreground/60 hover:text-foreground transition-colors"
            >
              02. Solution
            </a>
            {
              hasDecisions && (
                <a
                  href="#architecture"
                  data-toc-link
                  class="text-xs font-mono uppercase tracking-wider text-foreground/60 hover:text-foreground transition-colors"
                >
                  03. Decisions
                </a>
              )
            }
            <a
              href="#impact"
              data-toc-link
              class="text-xs font-mono uppercase tracking-wider text-foreground/60 hover:text-foreground transition-colors"
            >
              {hasDecisions ? "04. Impact" : "03. Impact"}
            </a>
            {
              moreImages.length > 0 && (
                <a
                  href="#more-images"
                  data-toc-link
                  class="text-xs font-mono uppercase tracking-wider text-foreground/60 hover:text-foreground transition-colors"
                >
                  {hasDecisions ? "05. Screenshots" : "04. Screenshots"}
                </a>
              )
            }
          </nav>
        </div>
      </aside>

      <article class="md:col-span-9 flex flex-col gap-14 sm:gap-16">
        <section id="challenge" class="scroll-mt-28 flex flex-col gap-3.5 max-w-[58ch]">
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">[01]</span>
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-foreground">
            The challenge
          </h2>
          <p class="text-base sm:text-lg leading-relaxed text-foreground/80 text-pretty">
            {work.challenge}
          </p>
        </section>

        <section id="solution" class="scroll-mt-28 flex flex-col gap-3.5 max-w-[58ch]">
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">[02]</span>
          <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-foreground">
            The solution
          </h2>
          <p class="text-base sm:text-lg leading-relaxed text-foreground/80 text-pretty">
            {work.solution}
          </p>
        </section>

        {
          hasDecisions && (
            <section id="architecture" class="scroll-mt-28 flex flex-col gap-5 max-w-[64ch]">
              <div class="flex flex-col gap-2">
                <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">[03]</span>
                <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-foreground">
                  Key technical decisions
                </h2>
              </div>

              <ol class="flex flex-col divide-y divide-foreground/20 border-t border-b border-foreground/20">
                {work.technicalDecisions &&
                  work.technicalDecisions.map((decision, index) => (
                    <li class="flex flex-col sm:flex-row gap-3 sm:gap-6 py-6">
                      <span class="text-xs font-mono uppercase tracking-wider text-foreground/50 shrink-0 pt-0.5">
                        [{String(index + 1).padStart(2, "0")}]
                      </span>
                      <div class="flex flex-col gap-1.5">
                        <h3 class="text-base sm:text-lg font-semibold text-foreground leading-snug">
                          {decision.title}
                        </h3>
                        <p class="text-sm sm:text-base leading-relaxed text-foreground/75 text-pretty">
                          {decision.description}
                        </p>
                      </div>
                    </li>
                  ))}
              </ol>
            </section>
          )
        }

        <section
          id="impact"
          class="scroll-mt-28 flex flex-col gap-2.5 border-l-[3px] border-foreground bg-foreground/[0.02] p-6 sm:p-8 max-w-[58ch]"
        >
          <span class="text-xs font-mono uppercase tracking-wider text-foreground/60">
            Outcomes &amp; impact
          </span>
          <p class="text-base sm:text-xl font-medium leading-relaxed text-foreground text-pretty">
            {work.impact}
          </p>
        </section>
      </article>
    </div>

    {/* Additional Screenshots & Lightbox */}
    {
      moreImages.length > 0 && (
        <section
          id="more-images"
          aria-label="Additional Screenshots"
          class="scroll-mt-28 flex flex-col gap-8 pt-4"
        >
          <div class="flex items-center justify-between border-b border-foreground/20 pb-4">
            <h2 class="text-xs uppercase tracking-wider font-medium text-foreground/65">
              Additional screenshots
            </h2>
            <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
              {String(moreImages.length).padStart(2, "0")} {moreImages.length === 1 ? "Screen" : "Screens"}
            </span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-10">
            {moreImages.map((img, idx) => (
              <figure class="group flex flex-col gap-2.5">
                <button
                  type="button"
                  data-lightbox-open={idx}
                  aria-label={`Expand ${work.title} screen ${idx + 2} in viewer`}
                  class="relative w-full text-left cursor-zoom-in focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
                >
                  <div class="w-full aspect-video border border-foreground/20 bg-foreground/5 relative overflow-hidden">
                    <Image
                      src={img}
                      alt={`${work.title} screen ${idx + 2}`}
                      class="w-full h-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03]"
                      loading="lazy"
                      widths={[600, 900, 1200]}
                      sizes="(min-width: 768px) 50vw, 100vw"
                    />

                    <div class="pointer-events-none absolute inset-0 bg-background/0 group-hover:bg-background/10 transition-colors duration-200 flex items-end justify-end p-3">
                      <span class="opacity-0 translate-y-1 group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 inline-flex items-center gap-1.5 border border-foreground bg-background px-2.5 py-1 text-[10px] font-mono uppercase tracking-wider text-foreground">
                        <span>Inspect</span>
                        <ArrowUp width={11} height={11} aria-hidden="true" class="rotate-45" />
                      </span>
                    </div>
                  </div>
                </button>

                <figcaption class="flex items-center justify-between text-xs font-mono uppercase tracking-wider text-foreground/50">
                  <span>
                    {work.title} / Screen {String(idx + 2).padStart(2, "0")}
                  </span>
                  <span>
                    {String(idx + 1).padStart(2, "0")} / {String(moreImages.length).padStart(2, "0")}
                  </span>
                </figcaption>
              </figure>
            ))}
          </div>

          <dialog
            id="gallery-lightbox"
            aria-label="Screenshot Viewer"
            class="m-auto w-full max-w-6xl bg-background text-foreground border border-foreground/30 p-0 open:flex open:flex-col"
          >
            <div class="flex items-center justify-between border-b border-foreground/20 px-4 sm:px-6 py-3.5">
              <span
                id="lightbox-caption"
                class="text-xs font-mono uppercase tracking-wider text-foreground/75 truncate pr-4"
              />
              <div class="flex items-center gap-2 shrink-0">
                <button
                  type="button"
                  id="lightbox-prev"
                  aria-label="Previous screenshot"
                  class="inline-flex h-8 w-8 items-center justify-center border border-foreground/25 text-xs font-mono hover:border-foreground hover:bg-foreground hover:text-background transition-colors cursor-pointer"
                >
                  <ArrowUp width={13} height={13} aria-hidden="true" class="-rotate-90" />
                </button>
                <button
                  type="button"
                  id="lightbox-next"
                  aria-label="Next screenshot"
                  class="inline-flex h-8 w-8 items-center justify-center border border-foreground/25 text-xs font-mono hover:border-foreground hover:bg-foreground hover:text-background transition-colors cursor-pointer"
                >
                  <ArrowUp width={13} height={13} aria-hidden="true" class="rotate-90" />
                </button>
                <button
                  type="button"
                  id="lightbox-close"
                  aria-label="Close viewer"
                  class="ml-1 inline-flex h-8 items-center justify-center border border-foreground/25 px-3 text-[11px] font-mono uppercase tracking-wider hover:border-foreground hover:bg-foreground hover:text-background transition-colors cursor-pointer"
                >
                  Close
                </button>
              </div>
            </div>

            <div class="p-4 sm:p-8 flex items-center justify-center bg-foreground/[0.02] min-h-[260px] sm:min-h-[420px]">
              <img
                id="lightbox-img"
                src=""
                alt=""
                class="max-h-[75vh] w-auto max-w-full object-contain border border-foreground/20"
              />
            </div>
          </dialog>
        </section>
      )
    }

    {/* Next Case Study & Hiring CTA */}
    <footer class="flex flex-col gap-12 pt-4">
      <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

      {
        nextWork && nextWork.slug !== work.slug && (
          <a
            href={`/works/${nextWork.slug}`}
            class="group grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-4 items-center border-b border-foreground/20 pb-10 transition-colors hover:bg-foreground/[0.02] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
          >
            <div class="col-span-6 sm:col-span-2">
              <span class="text-xs font-mono uppercase tracking-wider text-foreground/55">
                Next Study
              </span>
            </div>

            <div class="col-span-6 sm:col-span-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div class="flex flex-col gap-1">
                <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
                  {nextWork.organization}
                </span>
                <span class="text-2xl sm:text-4xl font-semibold tracking-[-0.025em] text-foreground underline decoration-transparent underline-offset-4 group-hover:decoration-foreground transition-colors">
                  {nextWork.title}
                </span>
              </div>

              <span class="inline-flex items-center gap-2 text-xs uppercase tracking-wider font-medium text-foreground/80 group-hover:text-foreground">
                <span>Read case study</span>
                <ArrowUp
                  width={15}
                  height={15}
                  aria-hidden="true"
                  class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
                />
              </span>
            </div>
          </a>
        )
      }

      <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-6 items-center">
        <div class="col-span-6 sm:col-span-2">
          <span class="text-xs uppercase tracking-wider font-medium text-foreground/60">
            Contact
          </span>
        </div>

        <div class="col-span-6 sm:col-span-10 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="flex flex-col gap-1">
            <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.02em] text-foreground">
              Need an engineer with this stack?
            </h2>
            <p class="text-sm sm:text-base text-foreground/70">
              Let's talk through your product goals, architecture needs or team openings.
            </p>
          </div>

          <a
            href="/contact"
            class="group inline-flex h-11 w-full sm:w-fit shrink-0 items-center justify-center gap-2.5 bg-foreground px-7 text-xs uppercase tracking-wider font-medium text-background transition-colors duration-150 hover:bg-foreground/85 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
          >
            <span>Get in touch</span>
            <ArrowUp
              width={14}
              height={14}
              aria-hidden="true"
              class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
            />
          </a>
        </div>
      </div>
    </footer>
  </main>
</Layout>

<script is:inline define:vars={{ workTitle: work.title, gallerySrcs: moreImages.map((img) => img.src) }}>
  let lightboxController = null;

  function initGalleryLightbox() {
    lightboxController?.abort();
    lightboxController = new AbortController();
    const { signal } = lightboxController;

    const dialog = document.getElementById("gallery-lightbox");
    const imgEl = document.getElementById("lightbox-img");
    const captionEl = document.getElementById("lightbox-caption");
    const prevBtn = document.getElementById("lightbox-prev");
    const nextBtn = document.getElementById("lightbox-next");
    const closeBtn = document.getElementById("lightbox-close");
    const triggers = document.querySelectorAll("[data-lightbox-open]");

    if (!dialog || !imgEl || !captionEl || !Array.isArray(gallerySrcs) || !gallerySrcs.length) return;

    let currentIndex = 0;

    function renderSlide(index) {
      currentIndex = (index + gallerySrcs.length) % gallerySrcs.length;
      const screenNum = String(currentIndex + 2).padStart(2, "0");
      const pos = `${String(currentIndex + 1).padStart(2, "0")} / ${String(gallerySrcs.length).padStart(2, "0")}`;

      imgEl.src = gallerySrcs[currentIndex];
      imgEl.alt = `${workTitle} screen ${screenNum}`;
      captionEl.textContent = `${workTitle} / Screen ${screenNum} (${pos})`;
    }

    triggers.forEach((btn) => {
      btn.addEventListener(
        "click",
        () => {
          const idx = Number(btn.getAttribute("data-lightbox-open") || 0);
          renderSlide(idx);
          if (typeof dialog.showModal === "function") {
            dialog.showModal();
          }
        },
        { signal },
      );
    });

    prevBtn?.addEventListener("click", () => renderSlide(currentIndex - 1), { signal });
    nextBtn?.addEventListener("click", () => renderSlide(currentIndex + 1), { signal });
    closeBtn?.addEventListener("click", () => dialog.close(), { signal });

    dialog.addEventListener(
      "click",
      (e) => {
        if (e.target === dialog) dialog.close();
      },
      { signal },
    );

    dialog.addEventListener(
      "keydown",
      (e) => {
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          renderSlide(currentIndex - 1);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          renderSlide(currentIndex + 1);
        }
      },
      { signal },
    );
  }

  initGalleryLightbox();
  document.addEventListener("astro:page-load", initGalleryLightbox);
</script>

<script>
  let activeObserver: IntersectionObserver | null = null;

  function initTocScrollSpy() {
    activeObserver?.disconnect();

    const sections = document.querySelectorAll<HTMLElement>("section[id]");
    const navLinks = document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]");
    if (!sections.length || !navLinks.length) return;

    activeObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute("id");
            navLinks.forEach((link) => {
              const isActive = link.getAttribute("href") === `#${id}`;
              link.classList.toggle("text-foreground", isActive);
              link.classList.toggle("font-semibold", isActive);
              link.classList.toggle("text-foreground/60", !isActive);
            });
          }
        });
      },
      { rootMargin: "-20% 0px -65% 0px" },
    );

    sections.forEach((section) => activeObserver?.observe(section));
  }

  initTocScrollSpy();
  document.addEventListener("astro:page-load", initTocScrollSpy);
</script>
