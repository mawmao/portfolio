---
import Github from "@/assets/icons/github.svg";

const navLinks = [
  { name: "Index", path: "/" },
  { name: "Works", path: "/works" },
  { name: "About", path: "/about" },
  { name: "Contact", path: "/contact" },
];

const currentPath = Astro.url.pathname;
const basePath = currentPath === "/" ? "/" : `/${currentPath.split("/")[1]}`;
---

<header
  id="site-header"
  data-scrolled="false"
  class="sticky top-0 z-20 shrink-0 bg-background/95 backdrop-blur-xs border-b border-transparent transition-colors duration-150 data-[scrolled=true]:border-foreground/20"
>
  <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-4 items-center h-[72px] sm:h-[80px]">
    <div class="col-span-2 sm:col-span-2 flex items-center">
      <a
        href="/"
        class="interactive-link group inline-flex items-center gap-2 py-1 text-sm sm:text-base font-semibold tracking-[-0.02em] text-foreground transition-opacity hover:opacity-75 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
        aria-label="Mel Adry - Home"
      >
        <span>Mel Adry</span>
      </a>
    </div>

    <nav
      aria-label="Main navigation"
      class="col-span-4 sm:col-span-10 flex items-center justify-end sm:justify-between"
    >
      <ul class="flex items-center gap-4 sm:gap-7">
        {
          navLinks.map(({ name, path }) => {
            const isActive = path === basePath;

            return (
              <li>
                <a
                  href={path}
                  aria-current={isActive ? "page" : undefined}
                  class:list={[
                    "interactive-link text-xs uppercase tracking-wider transition-colors py-1 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground",
                    isActive
                      ? "font-semibold text-foreground underline decoration-2 decoration-foreground underline-offset-[6px]"
                      : "font-medium text-foreground/60 hover:text-foreground",
                  ]}
                >
                  {name}
                </a>
              </li>
            );
          })
        }
      </ul>

      <div class="hidden sm:flex items-center gap-5 pl-6 border-l border-foreground/20">
        <a
          class="interactive-link inline-flex items-center gap-2 text-xs font-mono uppercase tracking-wider text-foreground/65 hover:text-foreground transition-colors focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
          href="https://github.com/mawmao"
          target="_blank"
          aria-label="GitHub profile (opens in a new tab)"
          rel="noopener noreferrer"
        >
          <Github width={17} height={17} aria-hidden="true" />
          <span>GitHub</span>
        </a>
      </div>
    </nav>
  </div>
</header>

<script>
  let scrollController: AbortController | null = null;

  function initHeaderScroll() {
    scrollController?.abort();
    scrollController = new AbortController();

    const header = document.querySelector<HTMLElement>("#site-header");
    if (!header) return;

    const updateHeader = () => {
      header.dataset.scrolled = String(window.scrollY > 24);
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, {
      passive: true,
      signal: scrollController.signal,
    });
  }

  initHeaderScroll();
  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
