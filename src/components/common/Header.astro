---
import Github from "@/assets/icons/github.svg";

const navLinks = [
  { name: "index", path: "/" },
  { name: "works", path: "/works" },
  { name: "about", path: "/about" },
  { name: "contact", path: "/contact" },
];

const currentPath = Astro.url.pathname;
const basePath = currentPath === "/" ? "/" : `/${currentPath.split("/")[1]}`;
---

<header
  id="site-header"
  data-scrolled="false"
  class="top-0 sticky z-20 h-[76px] sm:h-[80px] flex items-center justify-between shrink-0 bg-background/95 backdrop-blur-xs border-b border-dashed border-transparent transition-colors duration-150 data-[scrolled=true]:border-foreground/20"
>
  <a
    href="/"
    class="interactive-link group inline-flex items-center shrink-0 py-1"
    aria-label="Mel Adry - Home"
  >
    <span
      class="flex items-center justify-center font-mono text-sm sm:text-base font-bold uppercase tracking-tighter text-foreground leading-none transition-colors duration-200 group-hover:text-foreground/75"
    >
      Mel Adry
    </span>
  </a>

  <nav aria-label="Main navigation">
    <ul class="flex gap-3 sm:gap-6 items-center">
      {
        navLinks.map(({ name, path }) => {
          const isActive = path === basePath;

          return (
            <li>
              <a
                href={path}
                aria-current={isActive ? "page" : undefined}
                class:list={[
                  "interactive-link text-xs sm:text-sm uppercase tracking-wider transition-opacity",
                  isActive
                    ? "font-medium underline decoration-foreground underline-offset-4 opacity-100"
                    : "opacity-55 hover:opacity-100",
                ]}
              >
                {name}
              </a>
            </li>
          );
        })
      }

      <li class="pl-1 sm:pl-5 border-l inline-flex border-dashed border-foreground/20">
        <a
          class="interactive-link inline-flex items-center justify-center opacity-75 hover:opacity-100 transition-opacity"
          href="https://github.com/mawmao"
          target="_blank"
          aria-label="GitHub (opens in a new tab)"
          rel="noopener noreferrer"
        >
          <Github width={20} height={20} aria-hidden="true" />
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  function initHeaderScroll() {
    const header = document.querySelector<HTMLElement>("#site-header");
    if (!header) return;

    const updateHeader = () => {
      header.dataset.scrolled = String(window.scrollY > 24);
    };

    updateHeader();
    window.addEventListener("scroll", updateHeader, { passive: true });
  }

  initHeaderScroll();
  document.addEventListener("astro:page-load", initHeaderScroll);
</script>
