---
import type { ImageMetadata } from "astro";

import WorkImage from "./WorkImage.astro";
import TechTag from "./ui/TechTag.astro";

interface Props {
  title: string;
  tags: string[];
  organization: string;
  description: string;
  images: [ImageMetadata, ...ImageMetadata[]];
  href: string;
  reverse?: boolean;
}

const { title, tags, organization, description, images, href, reverse } = Astro.props;
---

<a
  href={href}
  aria-label={`Read case study about ${title}`}
  class:list={[
    "group relative flex flex-col gap-8 sm:gap-10 p-4 sm:p-6 -mx-4 sm:-mx-6 border border-dashed border-transparent hover:border-foreground/20 hover:bg-foreground/[0.02] transition-all duration-300",
    "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground",
    reverse ? "md:flex-row-reverse" : "md:flex-row",
  ]}
>
  <div class="relative aspect-4/3 w-full flex-3 sm:aspect-auto sm:min-h-80">
    <WorkImage orientation="top-left" src={images[0]} alt={`${title} interface screenshot 1`} />
    {images[1] && <WorkImage orientation="bottom-right" src={images[1]} alt={`${title} interface screenshot 2`} />}
  </div>

  <div class="flex flex-2 flex-col gap-6 sm:px-4 py-4 sm:py-6 justify-between">
    <div class="flex flex-col gap-5">
      <header class="flex flex-col gap-2.5">
        <span class="text-xs font-mono uppercase tracking-widest text-foreground/60">
          {organization}
        </span>

        <h3 class="text-3xl sm:text-4xl font-bold uppercase -tracking-tight-2 leading-none">
          <span
            class="underline decoration-foreground/25 underline-offset-4 group-hover:decoration-foreground transition-all"
          >
            {title}
          </span>
        </h3>

        <div class="flex flex-wrap gap-1.5 mt-1">
          {tags.map((tag) => <TechTag name={tag} />)}
        </div>
      </header>

      <p class="leading-relaxed text-sm text-foreground/75 max-w-prose">
        {description}
      </p>
    </div>

    <div class="mt-4 border-t border-dashed border-foreground/20 pt-5">
      <div
        class="flex h-12 w-full items-center justify-between bg-foreground px-6 text-xs sm:text-sm font-mono uppercase tracking-wider text-background transition-colors duration-300 group-hover:bg-foreground/85"
      >
        <span>View Case Study</span>

        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </div>
    </div>
  </div>
</a>
