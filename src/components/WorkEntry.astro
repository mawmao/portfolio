---
import type { ImageMetadata } from "astro";

import ArrowUp from "@/assets/icons/arrow-up.svg";
import WorkImage from "./WorkImage.astro";
import TechTag from "./ui/TechTag.astro";

interface Props {
  title: string;
  tags: string[];
  organization: string;
  description: string;
  images: [ImageMetadata, ImageMetadata];
  href: string;
  reverse?: boolean;
}

const { title, tags, organization, description, images, href, reverse } =
  Astro.props;
---

<article
  class:list={[
    "flex flex-col gap-8",
    reverse ? "md:flex-row-reverse" : "md:flex-row",
  ]}
>
  <div class="relative aspect-4/3 w-full flex-3 sm:aspect-auto sm:min-h-80">
    <WorkImage
      orientation="top-left"
      src={images[0]}
      alt={`${title} interface screenshot 1`}
    />
    <WorkImage
      orientation="bottom-right"
      src={images[1]}
      alt={`${title} interface screenshot 2`}
    />
  </div>

  <div class="flex flex-2 flex-col gap-6 sm:px-8 py-8 justify-between">
    <div class="flex flex-col gap-6">
      <header class="flex flex-col gap-3">
        <span class="text-xs font-light uppercase tracking-wider text-foreground/75">
          {organization}
        </span>

        <h4 class="text-4xl font-medium uppercase leading-none">{title}</h4>

        <div class="flex flex-wrap gap-2 mt-2">
          {tags.map((tag) => <TechTag name={tag} />)}
        </div>
      </header>

      <p class="leading-relaxed text-xs sm:text-sm text-foreground/80 max-w-prose">
        {description}
      </p>
    </div>

    <footer class="mt-4">
      <a
        href={href}
        aria-label={`Read more about ${title}`}
        class="group inline-flex h-12 w-full cursor-pointer items-center justify-center gap-2 border border-foreground/30 px-4 text-sm font-medium uppercase text-foreground/80 transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
      >
        <span>Read more</span>
        <ArrowUp
          width={18}
          height={18}
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </footer>
  </div>
</article>
