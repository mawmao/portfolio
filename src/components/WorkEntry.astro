---
import type { ImageMetadata } from "astro";

import WorkImage from "./WorkImage.astro";
import TechTag from "./ui/TechTag.astro";

interface Props {
  index: number;
  title: string;
  tags: string[];
  organization: string;
  description: string;
  images: [ImageMetadata, ...ImageMetadata[]];
  href: string;
  isPrivate?: boolean;
}

const {
  index,
  title,
  tags,
  organization,
  description,
  images,
  href,
  isPrivate = false,
} = Astro.props;

const formattedIndex = String(index).padStart(2, "0");
---

<a
  href={href}
  aria-label={`Read case study about ${title}`}
  class:list={[
    "group grid grid-cols-6 sm:grid-cols-12 gap-x-6 gap-y-8 py-10 sm:py-14 transition-colors duration-200 hover:bg-foreground/2",
    "focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground",
  ]}
>
  <div class="col-span-6 sm:col-span-2 flex sm:flex-col justify-between sm:justify-start gap-2 pt-1">
    <div class="flex items-center gap-2">
      <span class="text-xs font-mono uppercase tracking-wider text-foreground/50">
        [{formattedIndex}]
      </span>
      {
        isPrivate && (
          <span class="inline-flex items-center gap-1 border border-foreground/25 px-1.5 py-0.5 text-[10px] font-mono uppercase tracking-wider text-foreground/65">
            Private
          </span>
        )
      }
    </div>
    <span class="text-xs uppercase tracking-wider font-medium text-foreground/70">
      {organization}
    </span>
  </div>

  <div class="col-span-6 sm:col-span-5 flex flex-col justify-between gap-8">
    <div class="flex flex-col gap-4">
      <h3 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] leading-[1.1] text-foreground">
        <span class="underline decoration-transparent underline-offset-4 group-hover:decoration-foreground transition-colors duration-200">
          {title}
        </span>
      </h3>

      <p class="text-sm sm:text-base leading-relaxed text-foreground/75 max-w-[46ch] text-pretty">
        {description}
      </p>

      <div class="flex flex-wrap gap-1.5 pt-1">
        {tags.map((tag) => <TechTag name={tag} />)}
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-4 pt-2">
      <span class="inline-flex h-11 items-center gap-3 bg-foreground px-6 text-xs uppercase tracking-wider font-medium text-background transition-colors duration-150 group-hover:bg-foreground/85">
        <span>Read Case Study</span>
        <svg
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-1"
        >
          <path d="M5 12h14M12 5l7 7-7 7" />
        </svg>
      </span>

      {
        isPrivate && (
          <span class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-foreground/55">
            <svg
              width="13"
              height="13"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <rect width="18" height="11" x="3" y="11" rx="0" ry="0" />
              <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            </svg>
            <span>Internal / No live demo</span>
          </span>
        )
      }
    </div>
  </div>

  <div class="col-span-6 sm:col-span-5 flex flex-col gap-3">
    <WorkImage src={images[0]} alt={`${title} primary interface`} />
    {
      images[1] && (
        <div class="grid grid-cols-2 gap-3">
          <WorkImage src={images[1]} alt={`${title} secondary view`} compact />
          <div class="hidden sm:flex items-end justify-end border border-foreground/15 bg-foreground/[0.02] p-3">
            <span class="text-[11px] uppercase tracking-wider font-medium text-foreground/50">
              {isPrivate ? "Architecture & Metrics" : "+ Architecture & Metrics"}
            </span>
          </div>
        </div>
      )
    }
  </div>
</a>
