---
import type { ImageMetadata } from "astro";

import ArrowUp from "@/assets/icons/arrow-up.svg";
import WorkImage from "./WorkImage.astro";
import TechTag from "./ui/TechTag.astro";

interface Props {
  title: string;
  tags: string[];
  organization: string;
  description: string;
  images: [ImageMetadata, ImageMetadata];
  href: string;
  reverse?: boolean;
}

const { title, tags, organization, description, images, href, reverse } = Astro.props;
---

<a
  href={href}
  aria-label={`Read case study about ${title}`}
  class:list={[
    "group relative flex flex-col gap-8 p-4 -m-4 transition-all duration-300",
    "hover:bg-foreground/2 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground",
    reverse ? "md:flex-row-reverse" : "md:flex-row",
  ]}
>
  <div class="relative aspect-4/3 w-full flex-3 sm:aspect-auto sm:min-h-80">
    <WorkImage orientation="top-left" src={images[0]} alt={`${title} interface screenshot 1`} />
    <WorkImage orientation="bottom-right" src={images[1]} alt={`${title} interface screenshot 2`} />
  </div>

  <div class="flex flex-2 flex-col gap-6 sm:px-4 py-8 justify-between">
    <div class="flex flex-col gap-6">
      <header class="flex flex-col gap-3">
        <span class="text-xs font-light uppercase tracking-wider text-foreground/75">
          {organization}
        </span>

        <h4 class="text-4xl font-medium uppercase leading-none flex items-center gap-3">
          <span
            class="underline decoration-foreground/20 underline-offset-4 group-hover:decoration-foreground transition-all"
          >
            {title}
          </span>
        </h4>

        <div class="flex flex-wrap gap-2 mt-2">
          {tags.map((tag) => <TechTag name={tag} />)}
        </div>
      </header>

      <p class="leading-relaxed text-xs sm:text-sm text-foreground/80 max-w-prose">
        {description}
      </p>
    </div>

    <footer class="mt-8 border-t border-dashed border-foreground/20 pt-6">
      <div
        class="flex h-12 w-full cursor-pointer items-center justify-between bg-foreground px-6 text-sm font-medium uppercase text-background transition-colors duration-300 group-hover:bg-foreground/80"
      >
        <span>View Case Study</span>

        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="transition-transform duration-300 group-hover:translate-x-1"
        >
          <path d="M5 12h14M12 5l7 7-7 7"></path>
        </svg>
      </div>
    </footer>
  </div>
</a>
