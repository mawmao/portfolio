---
import type { ImageMetadata } from "astro";

import ArrowUp from "@/assets/icons/arrow-up.svg";
import WorkImage from "./WorkImage.astro";

interface Props {
  title: string;
  subtitle: string;
  organization: string;
  description: string;
  images: [ImageMetadata, ImageMetadata];
  href: string;
  reverse?: boolean;
}

const { title, subtitle, organization, description, images, href, reverse } =
  Astro.props;
---

<article
  class:list={[
    "flex flex-col gap-8",
    reverse ? "md:flex-row-reverse" : "md:flex-row",
  ]}
>
  <div class="relative aspect-4/3 w-full flex-2 sm:aspect-auto sm:min-h-80">
    <WorkImage orientation="top-left" src={images[0]} alt="" />
    <WorkImage orientation="bottom-right" src={images[1]} alt="" />
  </div>

  <div class="flex flex-1 flex-col gap-6 sm:px-8 py-8">
    <header class="flex flex-col gap-2">
      <span class="text-sm font-light uppercase text-foreground/50">
        {organization}
      </span>

      <h4 class="text-4xl font-medium uppercase">{title}</h4>

      <p class="text-foreground/75">{subtitle}</p>
    </header>

    <p class="leading-normal text-xs sm:text-sm text-foreground/80">
      {description}
    </p>

    <footer>
      <a
        href={href}
        class="group inline-flex h-12 w-full cursor-pointer items-center justify-center gap-1 border border-foreground/30 px-4 text-sm font-medium uppercase text-foreground/80 transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-foreground"
      >
        <span>Read more</span>
        <ArrowUp
          width={18}
          height={18}
          aria-hidden="true"
          class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </footer>
  </div>
</article>
