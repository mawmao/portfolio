---
interface Props {
  opacity?: number;
}

const { opacity = 15 } = Astro.props;

const calculatedOpacity = opacity / 100;
---

<div
  aria-hidden="true"
  class="fixed -z-10 top-0 left-0 w-full h-[460px] sm:h-[650px] pointer-events-none"
  style={{ opacity: calculatedOpacity }}
>
  <div class="flex size-full">
    {
      Array.from({ length: 12 }).map((_, index) => (
        <div
          class:list={[
            "flex-1 border-r border-dashed border-foreground",
            index % 2 === 0 && "hidden sm:block",
          ]}
        />
      ))
    }
  </div>

  <div class="absolute inset-0 flex flex-col">
    <div class="flex-1 border-dashed border-b border-b-foreground" }></div>
    <div class="flex-1 border-dashed border-b border-b-foreground" }></div>
    <div class="flex-1" }></div>
  </div>
</div>
