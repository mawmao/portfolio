---
import noise from "../assets/noise.png";

const { class: className, ...rest } = Astro.props;
---

<div
  transition:persist
  aria-hidden="true"
  class:list={["pointer-events-none fixed inset-0 z-50", className]}
  style={{
    backgroundImage: `url(${noise.src})`,
    backgroundRepeat: "repeat",
  }}
  {...rest}
>
</div>
