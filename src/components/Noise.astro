---
interface Props {
  opacity?: number;
}

const { opacity = 80 } = Astro.props;

const calculatedOpacity = opacity / 100
---

<div
  aria-hidden="true"
  class="pointer-events-none fixed inset-0 z-50 bg-repeat"
  style={{
    backgroundImage: "url('/noise.svg')",
    opacity: calculatedOpacity,
  }}
></div>
