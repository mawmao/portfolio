---
interface Props {
  opacity?: number;
  speed?: number;
  tilt?: number;
  latCount?: number;
  lonCount?: number;
  maxSize?: number;
  lineColor?: string;
  xOffset?: string;
  yOffset?: string;
}

const {
  opacity = 12,
  speed = 0.0015,
  tilt = 0.3,
  latCount = 15,
  lonCount = 24,
  maxSize = 1200,
  lineColor = "0, 0, 0",
  xOffset = "25%",
  yOffset = "0%",
} = Astro.props;
---


<div
  aria-hidden="true"
  class="globe-background absolute inset-0 -z-10 overflow-hidden pointer-events-none flex items-center justify-center"
>
  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    class="globe-video"
  >
    <source src="/videos/globe.webm" type="video/webm" />
    <source src="/videos/globe.mp4" type="video/mp4" />
  </video>
</div>

<style>
  .globe-video {
    width: 130vw;
    height: 130vw;
    max-width: 1200px;
    max-height: 1200px;
    object-fit: contain;
    transform: translate(25%, 0);
    opacity: 0.12;
    mix-blend-mode: multiply;
  }

  @media (min-width: 768px) {
    .globe-video {
      width: 80vw;
      height: 80vw;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .globe-video {
      visibility: hidden;
    }
  }
</style>
