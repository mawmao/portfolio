---
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string,
  hide?: boolean
}

const { orientation = "horizontal", class: className, hide = false, ...rest } = Astro.props;
---

<div
  role="separator"
  aria-orientation={orientation}
  class:list={[
    "bg-foreground/15",
    orientation === "horizontal" ? "h-px w-full" : "w-px h-full",
    className,
    hide && "bg-transparent"
  ]}
  {...rest}
/>
