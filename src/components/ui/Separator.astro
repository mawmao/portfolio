---
interface Props {
  orientation?: "horizontal" | "vertical";
  class?: string
}

const { orientation = "horizontal", class: className, ...rest } = Astro.props;
---

<div
  role="separator"
  aria-orientation={orientation}
  class:list={[
    "bg-foreground/15",
    orientation === "horizontal" ? "h-px w-full" : "w-px h-full",
    className
  ]}
  {...rest}
/>
