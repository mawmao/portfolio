---
import TypeScript from "@/assets/icons/typescript.svg";
import ReactJS from "@/assets/icons/react.svg";
import AstroIcon from "@/assets/icons/astro.svg";
import Supabase from "@/assets/icons/supabase.svg";
import Tailwind from "@/assets/icons/tailwind.svg";
import Cloudflare from "@/assets/icons/cloudflare.svg";
import CodeBrackets from "@/assets/icons/code-brackets.svg";
import Kotlin from "@/assets/icons/kotlin.svg";
import PostgreSQL from "@/assets/icons/postgresql.svg";
import Database from "@/assets/icons/database.svg"

interface Props {
  name: string;
}

const { name } = Astro.props;

const iconMap: Record<string, any> = {
  Astro: AstroIcon,
  TypeScript: TypeScript,
  React: ReactJS,
  Supabase: Supabase,
  "Tailwind CSS": Tailwind,
  Cloudflare: Cloudflare,
  Kotlin: Kotlin,
  PostgreSQL: PostgreSQL,
  RLS: Database
  // "shadcn/ui": ...
};

const Icon = iconMap[name] ?? CodeBrackets;
---

<span
  class="inline-flex items-center gap-1.5 rounded-full border border-foreground/20 bg-foreground/5 px-2.5 py-1 text-xs font-medium text-foreground/70"
>
  <Icon width={12} height={12} class="fill-current" />
  {name}
</span>
