---
import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
---

<SectionLayout id="contact-cta" class="py-24 sm:py-32 items-center text-center">
  <div class="flex flex-col items-center gap-8 max-w-2xl mx-auto">
    <h2 class="text-4xl sm:text-5xl md:text-6xl font-bold -tracking-tight-2">
      Let's build something <br class="hidden sm:block" /> together.
    </h2>
    <p class="text-foreground/60">
      Currently open for freelance opportunities and full-time roles.
    </p>
    <a
      href="/contact"
      class="group inline-flex h-14 w-full sm:w-auto cursor-pointer items-center justify-center gap-2 bg-foreground px-10 text-sm font-medium uppercase text-background transition-opacity duration-200 hover:opacity-80"
    >
      <span>Get in touch</span>
      <ArrowUp
        width={18}
        height={18}
        class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </a>
  </div>
</SectionLayout>
