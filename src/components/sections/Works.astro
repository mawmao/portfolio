---
import WorkEntry from "@/components/WorkEntry.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import { works } from "@/data/works";

const featuredWorks = works.filter((work) => work.featured);
---

<SectionLayout id="works" class="gap-12 sm:gap-16 py-16 sm:py-24">
  <div class="flex flex-col gap-6">
    <div class="h-[3px] w-full bg-foreground" aria-hidden="true"></div>

    <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-4 gap-y-4 items-baseline">
      <span class="col-span-6 sm:col-span-2 text-xs uppercase tracking-wider font-medium text-foreground/60">
        01 / Selected Works
      </span>

      <div class="col-span-6 sm:col-span-10 flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-2xl sm:text-3xl font-semibold tracking-[-0.025em] text-foreground">
          Production systems &amp; case studies
        </h2>

        <a
          href="/works"
          class="group inline-flex items-center gap-1.5 border-b border-foreground/40 pb-0.5 text-xs uppercase tracking-wider font-medium text-foreground/80 hover:border-foreground hover:text-foreground transition-colors"
        >
          <span>View all works ({works.length})</span>
          <ArrowUp
            width={13}
            height={13}
            class="rotate-45 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          />
        </a>
      </div>
    </div>
  </div>

  <div class="flex flex-col divide-y divide-foreground/20 border-t border-b border-foreground/20">
    {
      featuredWorks.map((work, index) => (
        <WorkEntry
          index={index + 1}
          title={work.title}
          tags={work.tags}
          organization={work.organization}
          description={work.description}
          images={work.images}
          href={`/works/${work.slug}`}
          isPrivate={work.isPrivate}
        />
      ))
    }
  </div>
</SectionLayout>
