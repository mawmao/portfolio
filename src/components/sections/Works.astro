---
import WorkEntry from "@/components/WorkEntry.astro";
import Separator from "../ui/Separator.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import { works } from "@/data/works";

const featuredWorks = works.filter((work) => work.featured);
---

<SectionLayout id="works" class="min-h-[500px] gap-16 py-10">
  <h3 class="text-xl text-foreground font-bold w-fit flex items-center gap-1">
    <span class="font-mono text-foreground/50 animate-pulse select-none">//</span>
    <span class="font-mono font-normal text-foreground/75">My Works</span>
    <span class="font-mono animate-pulse select-none">_</span>
  </h3>

  <div class="flex flex-col gap-6 sm:gap-14">
    {
      featuredWorks.map((work, index) => (
        <>
          <WorkEntry
            title={work.title}
            tags={work.tags}
            organization={work.organization}
            description={work.description}
            images={work.images}
            href={`/works/${work.slug}`}
            reverse={index % 2 !== 0}
          />
          {index !== featuredWorks.length - 1 && <Separator hide />}
        </>
      ))
    }
  </div>
</SectionLayout>
