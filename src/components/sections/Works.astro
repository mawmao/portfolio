---
import WorkEntry from "@/components/WorkEntry.astro";

import humay1 from "@/assets/images/humay-1.png";
import humay2 from "@/assets/images/humay-2.png";

import pcahto1 from "@/assets/images/pcahto-1.png";
import pcahto2 from "@/assets/images/pcahto-2.png";
import Separator from "../ui/Separator.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import { works } from "@/data/works";

const featuredWorks = works.filter((work) => work.featured);
---

<SectionLayout id="works" class="min-h-[500px] gap-16 py-10">
  <h3 class="text-xl bg-foreground text-background w-fit px-2 py-1.5">My Works</h3>

  <div class="flex flex-col gap-6 sm:gap-14">
    {
      featuredWorks.map((work, index) => (
        <>
          <WorkEntry
            title={work.title}
            tags={work.tags}
            organization={work.organization}
            description={work.description}
            images={work.images}
            href={`/works/${work.slug}`}
            reverse={index % 2 !== 0}
          />
          {index !== featuredWorks.length - 1 && <Separator hide />}
        </>
      ))
    }
  </div>
</SectionLayout>
