---
import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
---

<SectionLayout id="about-preview" class="min-h-[300px] justify-between gap-8">
  <div class="flex flex-col gap-6 max-w-3xl">
    <h3 class="text-xl bg-foreground text-background w-fit px-2 py-1.5">
      About Me
    </h3>

    <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-foreground/80">
      I'm a full-stack engineer based in the Philippines. I specialize in building resilient, clean, and highly functional web applications that solve real-world operational problems.
    </p>

    <a
      href="/about"
      class="group inline-flex h-12 w-fit cursor-pointer items-center justify-center gap-1 border border-foreground/30 px-6 text-sm font-medium uppercase text-foreground/80 transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
    >
      <span>More about me</span>
      <ArrowUp
        width={18}
        height={18}
        class="transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
      />
    </a>
  </div>
</SectionLayout>
