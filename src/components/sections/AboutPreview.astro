---
import { Image } from "astro:assets";
import Me from "@/assets/images/me-1.jpg";

import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
---

<SectionLayout id="about-preview" class="py-16 sm:py-24">
  <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-16 items-center">
    <div class="md:col-span-7 flex flex-col gap-8">
      <h2 class="text-sm sm:text-base text-foreground font-bold w-fit flex items-center gap-1.5">
        <span class="font-mono text-foreground/45 select-none">//</span>
        <span class="font-mono font-normal uppercase tracking-widest text-foreground/75">About</span>
        <span class="font-mono animate-pulse select-none">_</span>
      </h2>

      <div class="flex flex-col gap-5">
        <p class="text-2xl sm:text-3xl leading-tight font-semibold text-foreground -tracking-tight-2">
          I'm a <span class="underline decoration-foreground/30 underline-offset-4">full-stack engineer</span> based in
          the Philippines.
        </p>

        <p class="text-base sm:text-lg leading-relaxed text-foreground/75 max-w-prose">
          I specialize in building secure, multi-tenant SaaS platforms and internal dashboards. Whether it's for the web
          or mobile, I focus heavily on database architecture and strict Row Level Security (RLS) to keep sensitive data
          isolated. Right now, I'm building{" "}
          <a
            href="/works/verori"
            class="text-foreground font-semibold border-b border-dashed border-foreground/45 hover:border-foreground transition-colors"
          >
            my own Micro-SaaS
          </a>{" "}
          and helping clients turn prototypes into resilient production systems.
        </p>
      </div>

      <a
        href="/about"
        class="group inline-flex h-12 w-fit items-center justify-center gap-2 border border-foreground/30 px-6 text-xs sm:text-sm font-mono uppercase tracking-wider text-foreground transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
      >
        <span>More about me</span>
        <ArrowUp
          width={15}
          height={15}
          class="rotate-45 transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
        />
      </a>
    </div>

    <div class="md:col-span-5 relative aspect-square md:aspect-4/5 w-full max-w-md mx-auto md:ml-auto group">
      <div class="absolute inset-0 border border-foreground/20 bg-foreground/5 overflow-hidden shadow-xl">
        <Image
          src={Me}
          alt="Portrait of Mel Adry, Full-Stack Engineer"
          widths={[400, 720]}
          sizes="(min-width: 768px) 40vw, 100vw"
          class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 ease-out group-hover:scale-105"
        />
      </div>

      <div
        class="hidden sm:block absolute -inset-2 border border-dashed border-foreground/20 -z-10 translate-x-4 translate-y-4 transition-transform duration-500 group-hover:translate-x-5 group-hover:translate-y-5"
      ></div>
    </div>
  </div>
</SectionLayout>
