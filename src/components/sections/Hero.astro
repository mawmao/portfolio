---
import TypeScript from "@/assets/icons/typescript.svg";
import NextJS from "@/assets/icons/nextjs.svg";
import ReactJS from "@/assets/icons/react.svg";
import Supabase from "@/assets/icons/supabase.svg";
import Tailwind from "@/assets/icons/tailwind.svg";
import NodeJS from "@/assets/icons/node.svg";
import PostgreSQL from "@/assets/icons/postgresql.svg";

import Overlay from "../Overlay.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import GlobeBackground from "../GlobeBackground.astro";

const stack = [
  { name: "Next.js", icon: NextJS },
  { name: "React", icon: ReactJS },
  { name: "TypeScript", icon: TypeScript },
  { name: "Node.js", icon: NodeJS },
  { name: "PostgreSQL (RLS)", icon: PostgreSQL },
  { name: "Supabase", icon: Supabase },
  { name: "Tailwind", icon: Tailwind },
];

const label = "col-span-6 sm:col-span-2 text-xs uppercase tracking-wider font-medium text-foreground/60";
const content = "col-span-6 sm:col-span-10";
---

<SectionLayout
  id="hero"
  class="relative isolate overflow-hidden min-h-[85svh] sm:min-h-[680px] justify-between gap-14 sm:gap-16 pt-8! pb-8"
>
  <GlobeBackground />
  <Overlay opacity={10} />

  <div class="flex flex-col gap-12 sm:gap-16">
    <div class="hero-rule h-[3px] w-full bg-foreground" aria-hidden="true"></div>

    <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-4 gap-y-8 sm:gap-y-12 items-baseline">
      <div class={label}>Full-stack engineer</div>
      <div class={`${content} flex items-center gap-2.5 text-[13px] font-medium text-foreground/90`}>
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="motion-safe:animate-ping absolute inline-flex h-full w-full bg-emerald-500 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>Available for full-time &amp; contract roles</span>
      </div>

      <div class={`${label} hidden sm:block self-start pt-3`}>Overview</div>

      <h1
        class="col-span-6 sm:col-span-10 font-semibold text-[clamp(2.5rem,6vw,5.5rem)] leading-[1.04] tracking-[-0.035em] text-foreground"
      >
        <span class="block">I build full-stack systems</span>
        <span class="block text-foreground/65">that eliminate operational bottlenecks.</span>
      </h1>

      <div
        class="col-span-6 sm:col-span-10 sm:col-start-3 grid grid-cols-6 sm:grid-cols-10 gap-x-4 gap-y-8 items-end pt-2"
      >
        <p
          class="col-span-6 sm:col-span-6 max-w-[46ch] text-base sm:text-lg leading-relaxed text-foreground/80 text-pretty"
        >
          Full-stack delivery from <strong class="font-medium text-foreground">PostgreSQL Row-Level Security</strong> to <strong
            class="font-medium text-foreground">offline-capable mobile</strong
          >. I build reliable internal tools and customer-facing products that save engineering hours and support
          growth.
        </p>

        <div class="col-span-6 sm:col-span-4 flex flex-col sm:flex-row sm:justify-end gap-3 sm:gap-4">
          <a
            href="/works"
            class="inline-flex h-11 w-full sm:w-auto items-center justify-center bg-foreground px-7 text-sm font-medium text-background transition-colors duration-150 hover:bg-foreground/85 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
          >
            View my work
          </a>
          <a
            href="/contact"
            class="inline-flex h-11 w-full sm:w-auto items-center justify-center border border-foreground/30 px-6 text-sm font-medium text-foreground transition-colors duration-150 hover:border-foreground hover:bg-foreground hover:text-background focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-foreground"
          >
            Get in touch
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="grid grid-cols-6 sm:grid-cols-12 gap-x-4 gap-y-6 border-t border-foreground pt-4">
    <div class={label}>Focus</div>
    <p class={`${content} text-sm sm:text-base font-medium text-foreground/85`}>
      Secure SaaS, internal tools, and offline-first mobile.
    </p>

    <div class={label}>Stack</div>
    <ul
      aria-label="Technology stack"
      class="col-span-6 sm:col-span-10 grid grid-cols-2 sm:flex sm:flex-wrap gap-x-4 gap-y-3 sm:gap-x-5 sm:gap-y-3"
    >
      {
        stack.map(({ name, icon: Icon }) => (
          <li class="flex min-w-0 items-center gap-2 text-[13px] font-medium text-foreground/80 select-none">
            <Icon width={18} height={18} aria-hidden="true" class="shrink-0" />
            <span class="truncate">{name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</SectionLayout>

<style>
  @media (prefers-reduced-motion: no-preference) {
    .hero-rule {
      transform-origin: left center;
      animation: rule-draw 900ms cubic-bezier(0.2, 0.7, 0.1, 1) both;
    }
    @keyframes rule-draw {
      from {
        transform: scaleX(0);
      }
      to {
        transform: scaleX(1);
      }
    }
  }
</style>
