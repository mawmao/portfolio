---
import TypeScript from "@/assets/icons/typescript.svg";
import NextJS from "@/assets/icons/nextjs.svg";
import ReactJS from "@/assets/icons/react.svg";
import Supabase from "@/assets/icons/supabase.svg";
import Tailwind from "@/assets/icons/tailwind.svg";
import Expo from "@/assets/icons/expo.svg";
import AstroIcon from "@/assets/icons/astro.svg";

import Overlay from "../Overlay.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import GlobeBackground from "../GlobeBackground.astro";

const stack = [
  { name: "Next.js", icon: NextJS },
  { name: "React", icon: ReactJS },
  { name: "TypeScript", icon: TypeScript },
  { name: "React Native", icon: Expo },
  { name: "Astro", icon: AstroIcon },
  { name: "Supabase", icon: Supabase },
  { name: "Tailwind", icon: Tailwind },
];
---

<SectionLayout id="hero" class="min-h-[460px] sm:min-h-[640px] justify-between gap-12 pt-12 sm:pt-20 pb-8">
  <GlobeBackground />
  <Overlay opacity={12} />

  <div class="flex flex-col gap-6 sm:gap-8 max-w-4xl">
    <div class="flex items-center gap-2.5">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
      </span>
      <span class="text-xs font-mono uppercase tracking-widest text-foreground/65">
        Available for new projects
      </span>
    </div>

    <div class="flex flex-col gap-4 sm:gap-6 max-w-4xl">
      <h1 class="font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl -tracking-tight-2 leading-[1.15] text-balance">
        I build <br class="hidden sm:block" />
        <span class="inline-block border border-dashed border-foreground/40 px-3 py-0.5 bg-background/90">
          secure SaaS platforms
        </span>
        <br class="hidden sm:block" /> for web and mobile
      </h1>

      <p class="text-lg sm:text-xl md:text-2xl text-foreground/70 max-w-[48ch] leading-snug text-balance">
        I turn{" "}
        <span class="text-foreground font-medium border-b border-dashed border-foreground/40">
          complex business workflows
        </span>{" "}
        into clean, resilient software. From database architecture to mobile deployment.
      </p>
    </div>

    <div class="flex flex-wrap items-center gap-3 sm:gap-4 mt-2">
      <a
        href="/works"
        class="group inline-flex h-12 items-center justify-center gap-2 bg-foreground px-7 sm:px-8 text-xs sm:text-sm font-mono uppercase tracking-wider text-background transition-colors duration-200 hover:bg-foreground/85"
      >
        <span>View my work</span>
        <ArrowUp
          width={15}
          height={15}
          class="rotate-90 transition-transform duration-200 group-hover:translate-x-1"
        />
      </a>

      <a
        href="/contact"
        class="group inline-flex h-12 items-center justify-center gap-2 border border-foreground/30 bg-background/80 px-7 sm:px-8 text-xs sm:text-sm font-mono uppercase tracking-wider text-foreground transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
      >
        <span>Get in touch</span>
      </a>
    </div>
  </div>

  <ul
    aria-label="Technology stack"
    class="flex flex-wrap justify-start md:justify-end items-center gap-x-3 gap-y-2 border-t border-dashed border-foreground/20 pt-6"
  >
    {
      stack.map(({ name, icon: Icon }) => (
        <li
          class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-mono text-foreground/65 select-none
               not-last:after:ml-2 sm:not-last:after:ml-3 not-last:after:h-3
               not-last:after:w-px not-last:after:bg-foreground/25"
        >
          <Icon width={16} height={16} aria-hidden="true" />
          <span>{name}</span>
        </li>
      ))
    }
  </ul>
</SectionLayout>
