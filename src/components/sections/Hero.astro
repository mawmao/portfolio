---
import TypeScript from "@/assets/icons/typescript.svg";
import NextJS from "@/assets/icons/nextjs.svg";
import ReactJS from "@/assets/icons/react.svg";
import Supabase from "@/assets/icons/supabase.svg";
import Tailwind from "@/assets/icons/tailwind.svg";
import Expo from "@/assets/icons/expo.svg";
import AstroIcon from "@/assets/icons/astro.svg";

import Overlay from "../Overlay.astro";
import SectionLayout from "@/layouts/SectionLayout.astro";
import ArrowUp from "@/assets/icons/arrow-up.svg";
import GlobeBackground from "../GlobeBackground.astro";

const stack = [
  { name: "Next.js", icon: NextJS },
  { name: "React", icon: ReactJS },
  { name: "TypeScript", icon: TypeScript },
  { name: "React Native", icon: Expo },
  { name: "Astro", icon: AstroIcon },
  { name: "Supabase", icon: Supabase },
  { name: "Tailwind", icon: Tailwind },
];
---

<SectionLayout id="hero" class="min-h-[380px] sm:min-h-[670px] justify-between gap-12 pt-16 pb-8">
  <GlobeBackground />
  <Overlay opacity={12} />

  <div class="flex flex-col gap-6 sm:gap-8 max-w-4xl">
    <div class="flex items-center gap-3">
      <span class="relative flex h-2.5 w-2.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-500 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-green-500"></span>
      </span>
      <span class="text-xs font-mono uppercase tracking-widest text-foreground/60"> Available for new projects </span>
    </div>

    <div class="flex flex-col gap-4 sm:gap-6 max-w-4xl">
      <h1 class="font-bold text-4xl sm:text-5xl md:text-6xl lg:text-7xl -tracking-tight-2 leading-[1.2] text-balance">
        I build <br class="hidden sm:block" />
        <span class="border border-dashed border-foreground/40 px-3 bg-background"> secure SaaS platforms </span>
        <br class="hidden sm:block" /> for web and mobile
      </h1>

      <h2 class="text-lg sm:text-xl md:text-2xl text-foreground/70 max-w-[48ch] leading-snug text-balance">
        I turn <span class="text-foreground font-medium border-b border-dashed border-foreground/40"
          >complex business workflows</span
        > into clean, resilient software. From database architecture to mobile deployment.
      </h2>
    </div>

    <div class="flex flex-wrap items-center gap-4 mt-4">
      <a
        href="/works"
        class="group inline-flex h-12 cursor-pointer items-center justify-center gap-2 bg-foreground px-8 text-sm font-medium uppercase text-background transition-colors duration-200 hover:bg-foreground/80"
      >
        <span>View my work</span>
        <ArrowUp width={16} height={16} class="rotate-90 transition-transform duration-200 group-hover:translate-x-1" />
      </a>

      <a
        href="/contact"
        class="group inline-flex h-12 cursor-pointer items-center justify-center gap-2 border border-foreground/30 px-8 text-sm font-medium uppercase text-foreground/80 transition-colors duration-200 hover:border-foreground hover:bg-foreground hover:text-background"
      >
        <span>Get in touch</span>
      </a>
    </div>
  </div>

  <ul
    aria-label="Technology stack"
    class="flex flex-wrap justify-start items-center gap-x-2 gap-y-2 md:justify-end sm:gap-x-3 border-t border-dashed border-foreground/20 pt-6"
  >
    {
      stack.map(({ name, icon: Icon }) => {
        return (
          <li
            class="inline-flex items-center gap-1 sm:gap-1.5 text-xs sm:text-[13px] text-foreground/60 select-none
                 not-last:after:ml-2 sm:not-last:after:ml-2 not-last:after:h-3
                 not-last:after:w-px not-last:after:bg-foreground/30"
          >
            <Icon width={18} height={18} aria-hidden="true" />
            <span>{name}</span>
          </li>
        );
      })
    }
  </ul>
</SectionLayout>
