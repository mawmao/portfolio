---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  compact?: boolean;
}

const { src, alt, compact = false } = Astro.props;
---

<div
  class:list={[
    "relative w-full overflow-hidden border border-foreground/20 bg-foreground/5",
    compact ? "aspect-16/10" : "aspect-video",
  ]}
>
  <Image
    src={src}
    alt={alt}
    class="h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    format="webp"
    loading="lazy"
    decoding="async"
    quality={80}
    widths={[400, 800, 1200]}
    sizes="(min-width: 1024px) 42vw, (min-width: 640px) 45vw, 100vw"
  />
</div>
