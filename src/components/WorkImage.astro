---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

type Orientation =
  | "top-left"
  | "top"
  | "top-right"
  | "left"
  | "center"
  | "right"
  | "bottom-left"
  | "bottom"
  | "bottom-right";

interface Props {
  src: ImageMetadata;
  alt: string;
  orientation?: Orientation;
}

const { src, alt, orientation = "top-left" } = Astro.props;

const positions: Record<Orientation, string> = {
  "top-left": "top-0 left-0",
  top: "top-0 left-1/2 -translate-x-1/2",
  "top-right": "top-0 right-0",
  left: "top-1/2 left-0 -translate-y-1/2",
  center: "top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2",
  right: "top-1/2 right-0 -translate-y-1/2",
  "bottom-left": "bottom-0 left-0",
  bottom: "bottom-0 left-1/2 -translate-x-1/2",
  "bottom-right": "bottom-0 right-0",
};
---

<div
  class:list={[
    "absolute z-10 aspect-video w-[85%] sm:w-[80%] lg:w-[65%] overflow-hidden rounded-xs border border-foreground/20 bg-foreground/5 shadow-xl group",
    positions[orientation],
  ]}
>
  <div class="absolute inset-0 animate-pulse bg-foreground/10" aria-hidden="true"></div>

  <Image
    src={src}
    alt={alt}
    class="relative z-10 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
    format="webp"
    loading="lazy"
    decoding="async"
    quality={60}
    widths={[400, 800, 1200, 1600]}
    sizes="(min-width: 1024px) 65vw, (min-width: 640px) 80vw, 85vw"
    width={800}
    height={450}
  />
</div>
